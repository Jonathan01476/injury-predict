{
  "info": {
    "name": "Injury Predict - Live Modal API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://jonathan01476--injury-predict-api.modal.run",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health - 200",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Fitted model loaded', () => pm.expect(pm.response.json().model_loaded).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "Pipeline info - 200",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/pipeline"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Metadata present', () => { const d=pm.response.json(); pm.expect(d.steps).to.be.an('array').that.is.not.empty; pm.expect(d.sklearn_version).to.eql('1.7.2'); pm.expect(d.built_at).to.be.a('string'); pm.expect(d.expected_input_features).to.have.lengthOf(6); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Valid prediction - 200",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/predict",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"Player_Age\": 28,\n  \"Player_Weight\": 75,\n  \"Player_Height\": 180,\n  \"Previous_Injuries\": 0,\n  \"Training_Intensity\": 0.5,\n  \"Recovery_Time\": 4\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Actual prediction exists', () => { const d=pm.response.json(); pm.expect(d.prediction).to.be.oneOf([0,1]); pm.expect(d.injury_probability).to.be.within(0,1); pm.expect(d.target).to.eql('Likelihood_of_Injury'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid prediction - 422",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/predict",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"Player_Age\": 99,\n  \"Player_Weight\": 75,\n  \"Player_Height\": 180,\n  \"Previous_Injuries\": 0,\n  \"Training_Intensity\": 1.5,\n  \"Recovery_Time\": 0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 422', () => pm.response.to.have.status(422));",
              "pm.test('Validation details exist', () => pm.expect(pm.response.json().detail).to.be.an('array').that.is.not.empty);"
            ]
          }
        }
      ]
    }
  ]
}
